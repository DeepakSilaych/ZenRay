# =============================================================================
# Server (FastAPI) Configuration
# All variables use XRAY_ prefix
# =============================================================================

# Server
XRAY_PORT=4003
XRAY_DEBUG=false
XRAY_LOG_LEVEL=INFO

# PostgreSQL
XRAY_POSTGRES_HOST=localhost
XRAY_POSTGRES_PORT=5432
XRAY_POSTGRES_USER=xray
XRAY_POSTGRES_PASSWORD=xray_secret
XRAY_POSTGRES_DB=xray

# MinIO / S3
XRAY_S3_ENDPOINT=http://localhost:9000
XRAY_S3_ACCESS_KEY=minioadmin
XRAY_S3_SECRET_KEY=minioadmin
XRAY_S3_BUCKET=xray-blobs
XRAY_S3_REGION=us-east-1

# Redis
XRAY_REDIS_HOST=localhost
XRAY_REDIS_PORT=6379
XRAY_REDIS_DB=0

# JWT Authentication
XRAY_JWT_SECRET=change-this-in-production
XRAY_JWT_ALGORITHM=HS256
XRAY_JWT_EXPIRATION_HOURS=168

# Google OAuth
XRAY_GOOGLE_CLIENT_ID=your-google-client-id
XRAY_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend URL (for OAuth redirect)
XRAY_FRONTEND_URL=http://localhost:4002
