# =============================================================================
# ZenRay Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
WEB_PORT=4001
DASHBOARD_PORT=4002
SERVER_PORT=4003
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Infrastructure Hosts
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
REDIS_HOST=localhost
S3_ENDPOINT=http://localhost:9000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=xray
POSTGRES_PASSWORD=xray_secret
POSTGRES_DB=xray

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_DB=0

# -----------------------------------------------------------------------------
# MinIO / S3
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=xray-blobs
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-in-production

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:4002
SERVER_URL=http://localhost:4003

# -----------------------------------------------------------------------------
# Server (XRAY_ prefix for FastAPI pydantic-settings)
# -----------------------------------------------------------------------------
XRAY_PORT=4003
XRAY_DEBUG=false
XRAY_LOG_LEVEL=INFO
XRAY_POSTGRES_HOST=localhost
XRAY_POSTGRES_PORT=5432
XRAY_POSTGRES_USER=xray
XRAY_POSTGRES_PASSWORD=xray_secret
XRAY_POSTGRES_DB=xray
XRAY_S3_ENDPOINT=http://localhost:9000
XRAY_S3_ACCESS_KEY=minioadmin
XRAY_S3_SECRET_KEY=minioadmin
XRAY_S3_BUCKET=xray-blobs
XRAY_S3_REGION=us-east-1
XRAY_REDIS_HOST=localhost
XRAY_REDIS_PORT=6379
XRAY_REDIS_DB=0
XRAY_JWT_SECRET=change-this-in-production
XRAY_JWT_ALGORITHM=HS256
XRAY_JWT_EXPIRATION_HOURS=168
XRAY_GOOGLE_CLIENT_ID=your-google-client-id
XRAY_GOOGLE_CLIENT_SECRET=your-google-client-secret
XRAY_FRONTEND_URL=http://localhost:4002

# -----------------------------------------------------------------------------
# Web (PUBLIC_ prefix for Astro client-side)
# -----------------------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:4001
PUBLIC_DASHBOARD_URL=http://localhost:4002
PUBLIC_API_URL=http://localhost:4003
PUBLIC_GITHUB_URL=https://github.com/DeepakSilaych/ZenRay

# -----------------------------------------------------------------------------
# Dashboard (VITE_ prefix for Vite client-side)
# -----------------------------------------------------------------------------
VITE_SITE_URL=http://localhost:4001
VITE_GITHUB_URL=https://github.com/DeepakSilaych/ZenRay
VITE_DOCS_URL=http://localhost:4001/docs
# VITE_SERVER_URL=http://localhost:4003  # Uncomment to bypass proxy
