# =============================================================================
# Web (Astro) Configuration
# =============================================================================

# Port
WEB_PORT=4001

# Site URL (used for sitemap and canonical URLs)
PUBLIC_SITE_URL=http://localhost:4001

# Links (PUBLIC_ prefix for client-side access)
PUBLIC_DASHBOARD_URL=http://localhost:4002
PUBLIC_API_URL=http://localhost:4003
PUBLIC_GITHUB_URL=https://github.com/DeepakSilaych/ZenRay

# Allowed hosts (comma-separated, for Vite dev server)
ALLOWED_HOSTS=localhost,127.0.0.1
