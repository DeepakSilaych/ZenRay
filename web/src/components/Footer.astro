---
import { config } from "../config";

const links = {
  product: [
    { href: "/docs", label: "Docs" },
    { href: "/docs/sdk", label: "SDK Reference" },
    { href: "/docs/api", label: "API Reference" },
    { href: "/docs/examples", label: "Examples" },
  ],
  social: [{ href: config.githubUrl, label: "GitHub" }],
};
---

<footer class="border-t border-zinc-800 bg-zinc-950">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex flex-col md:flex-row justify-between gap-12">
      <!-- Logo & description -->
      <div class="max-w-sm">
        <a href="/" class="flex items-center gap-2 mb-4">
          <span class="font-semibold text-white">{config.siteName}</span>
        </a>
        <p class="text-zinc-500 text-sm leading-relaxed">
          {config.siteDescription}
        </p>
      </div>
      
      <!-- Links -->
      <div class="flex gap-16">
        <div>
          <h4 class="text-white font-medium text-sm mb-4">Links</h4>
          <ul class="space-y-2">
            {links.product.map((link) => (
              <li>
                <a href={link.href} class="text-zinc-500 hover:text-white text-sm transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        
        <div>
          <h4 class="text-white font-medium text-sm mb-4">Socials</h4>
          <ul class="space-y-2">
            {links.social.map((link) => (
              <li>
                <a href={link.href} class="text-zinc-500 hover:text-white text-sm transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
    
    <!-- Bottom -->
    <div class="mt-16 pt-8 border-t border-zinc-800 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-zinc-600 text-sm">&copy; {new Date().getFullYear()} {config.siteName}</p>
      <div class="flex items-center gap-6 text-sm text-zinc-600">
        <span>Security</span>
        <span>Privacy</span>
        <span>Terms</span>
      </div>
    </div>
  </div>
</footer>
