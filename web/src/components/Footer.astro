---
import { config } from "../config";

const links = {
  product: [
    { href: "/docs", label: "Docs" },
    { href: "/docs/sdk", label: "SDK Reference" },
    { href: "/docs/api", label: "API Reference" },
    { href: "/docs/examples", label: "Examples" },
  ],
  social: [{ href: config.githubUrl, label: "GitHub" }],
};
---

<footer class="border-t border-white/[0.05] bg-navy-950">
  <div class="max-w-7xl mx-auto px-6 py-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-24">
      <!-- Logo & description -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-6 group">
          <div class="w-8 h-8 rounded-lg bg-accent flex items-center justify-center shadow-lg shadow-accent/10 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5 text-navy-950" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
            </svg>
          </div>
          <span class="font-bold text-xl tracking-tight text-white">{config.siteName}</span>
        </a>
        <p class="text-zinc-500 text-sm leading-relaxed max-w-sm mb-8">
          {config.siteDescription}. Built for engineers who care about reliability and observability in their ML stack.
        </p>
        <div class="flex gap-4">
          <a href={config.githubUrl} class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white hover:border-white transition-all">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Links -->
        <div>
        <h4 class="text-white font-bold text-xs uppercase tracking-widest mb-6">Product</h4>
        <ul class="space-y-4">
            {links.product.map((link) => (
              <li>
              <a href={link.href} class="text-zinc-500 hover:text-white text-sm font-medium transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        
        <div>
        <h4 class="text-white font-bold text-xs uppercase tracking-widest mb-6">Support</h4>
        <ul class="space-y-4">
          <li><a href="#" class="text-zinc-500 hover:text-white text-sm font-medium transition-colors">Documentation</a></li>
          <li><a href="#" class="text-zinc-500 hover:text-white text-sm font-medium transition-colors">Guides</a></li>
          <li><a href="#" class="text-zinc-500 hover:text-white text-sm font-medium transition-colors">API Status</a></li>
          </ul>
      </div>
    </div>
    
    <!-- Bottom -->
    <div class="mt-24 pt-8 border-t border-white/[0.05] flex flex-col sm:flex-row justify-between items-center gap-6">
      <p class="text-zinc-600 text-sm font-medium">&copy; {new Date().getFullYear()} {config.siteName}. All rights reserved.</p>
      <div class="flex items-center gap-8 text-sm font-medium text-zinc-600">
        <a href="#" class="hover:text-white transition-colors">Security</a>
        <a href="#" class="hover:text-white transition-colors">Privacy</a>
        <a href="#" class="hover:text-white transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
