---
const links = [
  { href: "/docs", label: "Docs" },
  { href: "/docs/sdk", label: "SDK" },
  { href: "/docs/api", label: "API" },
  { href: "https://github.com/xray-dev/xray", label: "GitHub" },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 border-b border-zinc-800 bg-zinc-950/80 backdrop-blur-xl"
>
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-xl font-semibold">
      <span class="text-brand-500">◈</span>
      <span>X-Ray</span>
    </a>

    <div class="flex items-center gap-8">
      <div class="hidden md:flex items-center gap-6">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm text-zinc-400 hover:text-white transition-colors"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <a
        href="http://localhost:3000"
        class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-zinc-950 text-sm font-medium rounded-lg transition-colors"
      >
        Dashboard →
      </a>
    </div>
  </div>
</nav>
