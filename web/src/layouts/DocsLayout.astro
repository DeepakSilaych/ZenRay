---
import Layout from './Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props

const sidebar = [
  { href: '/docs', label: 'Getting Started' },
  { href: '/docs/sdk', label: 'SDK Reference' },
  { href: '/docs/api', label: 'API Reference' },
  { href: '/docs/examples', label: 'Examples' },
]
---

<Layout title={`${title} | X-Ray Docs`}>
  <Nav />
  
  <div class="pt-16 min-h-screen flex">
    <!-- Sidebar -->
    <aside class="w-64 border-r border-zinc-800 p-6 hidden lg:block">
      <nav class="sticky top-24 space-y-2">
        {sidebar.map(link => (
          <a 
            href={link.href}
            class="block px-4 py-2 rounded-lg text-sm text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </aside>
    
    <!-- Content -->
    <main class="flex-1 max-w-3xl px-8 py-12">
      <h1 class="text-4xl font-bold mb-4">{title}</h1>
      {description && <p class="text-xl text-zinc-400 mb-8">{description}</p>}
      
      <div class="prose prose-invert prose-zinc max-w-none">
        <slot />
      </div>
    </main>
  </div>
  
  <Footer />
</Layout>

<style>
  .prose :global(h2) {
    @apply text-2xl font-semibold mt-12 mb-4 text-white;
  }
  .prose :global(h3) {
    @apply text-xl font-medium mt-8 mb-3 text-white;
  }
  .prose :global(p) {
    @apply text-zinc-300 leading-relaxed mb-4;
  }
  .prose :global(pre) {
    @apply bg-zinc-900 border border-zinc-800 rounded-xl p-4 overflow-x-auto mb-6;
  }
  .prose :global(code) {
    @apply font-mono text-sm;
  }
  .prose :global(ul) {
    @apply list-disc list-inside space-y-2 text-zinc-300 mb-6;
  }
  .prose :global(table) {
    @apply w-full border-collapse mb-6;
  }
  .prose :global(th) {
    @apply text-left p-3 border-b border-zinc-800 text-zinc-400 text-sm font-medium;
  }
  .prose :global(td) {
    @apply p-3 border-b border-zinc-800 text-zinc-300;
  }
</style>

