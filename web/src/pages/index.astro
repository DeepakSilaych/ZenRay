---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { config } from "../config";

const logos = ["Anthropic", "OpenAI", "Pinecone", "LangChain", "Cohere", "Weaviate"];

const principles = [
  {
    title: "Visibility",
    desc: "Track every candidate through your pipeline. See exactly where items are dropped and why. Never guess again.",
  },
  {
    title: "Performance",
    desc: "Async batched ingestion with less than 1ms overhead. Your pipeline performance stays untouched.",
  },
  {
    title: "Code-First",
    desc: "Simple Python decorators integrate naturally with your existing code. No config files, no DSLs.",
  },
];

const useCases = [
  {
    id: "rag",
    title: "RAG Pipelines",
    subtitle: "Debug retrieval and context selection",
    desc: "Track document retrieval, reranking, and filtering. See exactly which documents made it to your LLM context and which were dropped.",
    quote: "X-Ray helped us identify why our RAG pipeline was missing relevant documents. Found the issue in 10 minutes.",
    author: "ML Engineer",
    company: "Series B Startup",
    code: `@xray.pipeline("rag")
def answer(question: str):
    docs = retrieve(question)      # 100 docs
    reranked = rerank(docs)        # 100 docs, scored
    filtered = filter(reranked)    # 5 docs
    return generate(question, filtered)

@xray.step("FILTER")
def filter(docs):
    for doc in docs:
        if doc.score < 0.3:
            xray.drop(doc, "low_relevance")
            continue
        yield doc`,
  },
  {
    id: "search",
    title: "Search & Ranking",
    subtitle: "Debug multi-stage ranking pipelines",
    desc: "Understand your e-commerce search, recommendation systems, and any pipeline that retrieves, scores, and filters candidates.",
    quote: "We reduced debugging time from hours to minutes. The candidate trace feature is invaluable.",
    author: "Staff Engineer",
    company: "E-commerce Platform",
    code: `@xray.pipeline("product-search")
def search(query: str, user_id: str):
    xray.tag("user_id", user_id)
    
    candidates = retrieve(query)
    scored = rank(candidates)
    filtered = apply_filters(scored)
    return personalize(filtered, user_id)[:10]

@xray.step("RANK")
def rank(items):
    for item in items:
        score = model.predict(item)
        xray.score(item, score)
        item.score = score
    return sorted(items, reverse=True)`,
  },
  {
    id: "agents",
    title: "AI Agents",
    subtitle: "Debug tool selection and decision paths",
    desc: "Track which tools were considered, why certain actions were chosen, and how your agent arrived at its final decision.",
    quote: "Finally we can understand why our agent chose one tool over another. Game changer for debugging.",
    author: "AI Engineer",
    company: "AI Startup",
    code: `@xray.pipeline("agent")
def run_agent(task: str):
    xray.tag("task_type", classify(task))
    
    tools = select_tools(task)
    for tool in tools:
        result = execute(tool, task)
        if is_complete(result):
            return result
    return fallback(task)

@xray.step("SELECT")
def select_tools(task):
    for tool in ALL_TOOLS:
        if not tool.matches(task):
            xray.drop(tool, "not_applicable")
            continue
        yield tool`,
  },
];

const howItWorks = [
  {
    step: "Step 1",
    title: "Add decorators to your code",
    desc: "Mark your pipeline entry point and each step with simple decorators. Track drops with xray.drop().",
  },
  {
    step: "Step 2",
    title: "Run your pipeline normally",
    desc: "Execute your code as usual. X-Ray captures data asynchronously in the background with minimal overhead.",
  },
  {
    step: "Step 3",
    title: "Debug in the dashboard",
    desc: "Browse runs, inspect steps, trace candidates. Understand exactly what happened at every stage.",
  },
];
---

<Layout title="X-Ray | ML Pipeline Observability">
  <Nav />
  
  <!-- Hero Section -->
  <section class="pt-32 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-accent/10 via-hatchet-bg/0 to-hatchet-bg/0 pointer-events-none"></div>
    <div class="max-w-5xl mx-auto px-6 text-center relative z-10">
      <h1 class="text-5xl md:text-7xl font-bold leading-[1.1] mb-6 tracking-tight text-white">
        The observability layer<br />for ML pipelines
      </h1>
      
      <p class="text-xl text-zinc-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        Stop guessing why your pipeline dropped candidates. Trace every item 
        through retrieval, ranking, and filtering in a single dashboard.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a 
          href={config.dashboardUrl}
          class="px-6 py-3 bg-accent text-hatchet-bg font-bold rounded-lg hover:bg-accent-light transition-colors shadow-[0_0_20px_rgba(34,211,238,0.3)]"
        >
          Start for free
        </a>
        <a 
          href="/docs" 
          class="px-6 py-3 border border-white/10 text-white font-medium rounded-lg hover:border-accent hover:text-accent transition-colors bg-white/5 backdrop-blur-sm"
        >
          Docs
        </a>
      </div>
      
      <!-- Logos -->
      <div class="border-t border-white/5 pt-12">
        <p class="text-sm text-zinc-500 uppercase tracking-widest mb-8">Works with your ML stack</p>
        <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-4 opacity-80">
          {logos.map((logo) => (
            <span class="text-sm font-medium text-zinc-500">{logo}</span>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <!-- Core Principles -->
  <section class="py-24 border-t border-white/5 bg-hatchet-surface/30">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-16 text-center">Core Principles</h2>
      
      <div class="grid md:grid-cols-3 gap-12">
        {principles.map((p) => (
          <div>
            <h3 class="text-lg font-semibold mb-3 text-white">{p.title}</h3>
            <p class="text-zinc-400 leading-relaxed text-sm">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Use Cases -->
  {useCases.map((uc, index) => (
    <section class="py-24 border-t border-white/5">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <!-- Left: Content -->
          <div>
            <p class="text-sm font-medium uppercase tracking-widest mb-4 text-accent">Use Case</p>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-2">{uc.title}</h2>
            <p class="text-lg text-zinc-400 mb-8">{uc.subtitle}</p>
            
            <div class="mb-8">
              <h4 class="text-white font-semibold mb-3">Debug with X-Ray</h4>
              <p class="text-zinc-400 leading-relaxed mb-6">{uc.desc}</p>
              
              <ul class="space-y-2 mb-6">
                <li class="text-zinc-400 text-sm"><span class="text-accent mr-2">•</span> Which documents were retrieved but filtered out</li>
                <li class="text-zinc-400 text-sm"><span class="text-accent mr-2">•</span> Relevance scores and drop reasons</li>
                <li class="text-zinc-400 text-sm"><span class="text-accent mr-2">•</span> Prompts sent to the LLM and responses</li>
              </ul>
            </div>
            
            <!-- Testimonial -->
            <div class="border-l-2 border-accent/50 pl-6">
              <p class="text-zinc-300 mb-4 text-sm">"{uc.quote}"</p>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-black font-bold text-xs bg-accent">
                  {uc.author[0]}
                </div>
                <div>
                  <p class="text-white font-medium text-sm">{uc.author}</p>
                  <p class="text-zinc-500 text-xs">{uc.company}</p>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Right: Code -->
          <div class="rounded-lg border border-white/10 overflow-hidden bg-[#0A0A0F]">
            <div class="flex items-center gap-2 px-4 py-2.5 border-b border-white/5 bg-white/5">
              <div class="flex gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-zinc-600"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-zinc-600"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-zinc-600"></div>
              </div>
              <span class="ml-2 text-xs text-zinc-500 font-mono">{uc.id}.py</span>
            </div>
            <pre class="p-5 text-xs font-mono overflow-x-auto text-zinc-300 leading-relaxed"><code>{uc.code}</code></pre>
          </div>
        </div>
      </div>
    </section>
  ))}
  
  <!-- How it works -->
  <section class="py-24 border-t border-white/5 bg-hatchet-surface/30">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-6">How it works</h2>
      <p class="text-zinc-400 text-center max-w-2xl mx-auto mb-16 text-sm">
        X-Ray runs as a separate service. Your pipeline sends data via the SDK, and you debug in the dashboard.
      </p>
      
      <div class="grid md:grid-cols-3 gap-12">
        {howItWorks.map((item) => (
          <div>
            <div class="text-sm font-medium text-accent mb-3">{item.step}</div>
            <h3 class="text-lg font-semibold text-white mb-2">{item.title}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <section class="py-24 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Start debugging your pipelines today
      </h2>
      <p class="text-zinc-400 mb-8 text-sm max-w-xl mx-auto">
        Fully managed. Add to your project in under 5 minutes.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/docs" 
          class="px-6 py-3 bg-accent text-hatchet-bg font-bold rounded-lg hover:bg-accent-light transition-colors shadow-[0_0_20px_rgba(34,211,238,0.3)]"
        >
          Get Started
        </a>
        <a 
          href={config.githubUrl}
          class="px-6 py-3 border border-white/10 text-white font-medium rounded-lg hover:border-accent hover:text-accent transition-colors bg-white/5 backdrop-blur-sm"
        >
          Star on GitHub
        </a>
      </div>
    </div>
  </section>
  
  <Footer />
</Layout>
